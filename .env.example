# Set these only in Vercel's server environment or your local shell.
# Do not commit real credentials. No Supabase key is used by the browser.
SUPABASE_URL=
# Recommended server-only key from Settings > API Keys.
SUPABASE_SECRET_KEY=
# Public browser SDK key, configured once on the server and safe to expose.
SUPABASE_PUBLISHABLE_KEY=
# Legacy service_role key also supported, if no secret key is set.
SUPABASE_SERVICE_ROLE_KEY=
